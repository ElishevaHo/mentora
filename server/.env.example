# Postgres connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/mentora

# Set to true when the database requires SSL (Neon, Supabase, external Render URL)
DB_SSL=false

# Any long random string
JWT_SECRET=change-me-to-a-long-random-string

PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Seed demo data automatically when the database is empty
AUTO_SEED=true

# Optional: creates admin@mentora.dev with this password during seeding
SEED_ADMIN_PASSWORD=
